# ── Local development (Vite) ─────────────────────────────────────
# PHP files (ai_proxy, api, PDF) do not run in Vite — requests are proxied to Hostinger.
# Change this if your live site uses a different domain:
VITE_PHP_PROXY_TARGET=https://eng-alaa.com

# Optional: override AI proxy URL directly (skip Vite proxy path)
# VITE_AI_PROXY_URL=https://eng-alaa.com/ai_proxy.php
